#!/bin/bash
# Display scaling — Omarchy's omarchy-hyprland-monitor-scaling-cycle.
#
# The scale is applied at once and written back to ~/.config/hypr/monitor.lua,
# which march generates at install time, so it survives a reboot. Only the
# compositor's scale is set: Wayland scales there, and the toolkit scaling
# variables Omarchy also writes would scale GTK windows a second time.
set -uo pipefail

MONITOR_LUA="$HOME/.config/hypr/monitor.lua"

# Omarchy's ladder, written for real monitors.
SCALES=(1 1.25 1.6 2 3 4)

case "${1-}" in
  scale-cycle) ;;
  *)
    echo "usage: march-display scale-cycle [--reverse]" >&2
    exit 2
    ;;
esac

read -r output current width height < <(
  hyprctl monitors -j | jq -r '.[] | select(.focused) | "\(.name) \(.scale) \(.width) \(.height)"'
)
if [[ -z ${output-} ]]; then
  echo "march-display: no focused monitor" >&2
  exit 1
fi

# Hyprland refuses a scale that does not divide the mode into whole logical
# pixels, and falls back to 1 when it gets one. A guest's height is whatever
# the host window happens to be — 2234 here — so most of the ladder above is
# not applicable to it, and cycling blind lands on 1 and stays there: every
# further step asks for another scale Hyprland will not take. So the ladder is
# filtered against this mode first and only what applies is cycled. On a
# 3456x2234 guest that leaves 1 and 2, which is the honest answer.
usable=()
for s in "${SCALES[@]}"; do
  if awk -v w="$width" -v h="$height" -v s="$s" 'BEGIN {
    lw = w / s; lh = h / s
    dw = lw - int(lw); if (dw > 0.5) dw = 1 - dw
    dh = lh - int(lh); if (dh > 0.5) dh = 1 - dh
    exit !(dw < 1e-6 && dh < 1e-6)
  }'; then
    usable+=("$s")
  fi
done
((${#usable[@]} > 0)) || usable=(1)

# The scale Hyprland reports is the one it applied, which after a rejection is
# not one that was ever asked for: the nearest usable entry is the one to step
# from.
index=$(awk -v current="$current" -v list="${usable[*]}" 'BEGIN {
  n = split(list, scales, " ")
  best = 0; best_diff = 1e9
  for (i = 1; i <= n; i++) {
    diff = current - scales[i]; if (diff < 0) diff = -diff
    if (diff < best_diff) { best_diff = diff; best = i - 1 }
  }
  print best
}')

if [[ ${2-} == "--reverse" ]]; then
  index=$(((index - 1 + ${#usable[@]}) % ${#usable[@]}))
else
  index=$(((index + 1) % ${#usable[@]}))
fi
scale="${usable[$index]}"

hyprctl eval "hl.monitor({ output = \"$output\", mode = \"preferred\", position = \"auto\", scale = $scale })" >/dev/null

if [[ -f $MONITOR_LUA ]]; then
  sed -i -E "s/^([[:space:]]*scale = )[0-9.]+,/\\1${scale},/" "$MONITOR_LUA"
fi

notify-send -a march -u low "󰍹    Display scaling set to ${scale}x" 2>/dev/null || true
