#!/bin/bash
# The toggles from Omarchy's Toggle menu that mean something in a VM.
#
# Omarchy's nightlight, stay-awake, screensaver and battery-percentage toggles
# are absent: there is no gamma ramp behind virtio-gpu, march runs no idle
# daemon, and there is no battery.
#
# Compositor settings are changed with `hyprctl eval`, which takes Lua now that
# hyprlang is gone. Hyprland has no "read this option back" that survives a
# hl.config() write, so the off-state is remembered in a file instead, and the
# on-state restores the values looknfeel.lua ships.
set -uo pipefail

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/march"

# Waybar re-runs a module's exec when signalled, so a toggle shows up in the bar
# at once instead of at the end of its interval. The numbers match the "signal"
# fields in waybar/config.jsonc.
refresh_bar() {
  pkill -RTMIN+"$1" waybar 2>/dev/null || true
}

mark() {
  mkdir -p "$STATE_DIR"
  touch "$STATE_DIR/$1"
}

case "${1-}" in
  dnd)
    makoctl mode -t do-not-disturb >/dev/null 2>&1
    refresh_bar 8
    ;;

  bar)
    # Restarting has to outlive this script, or waybar dies with it.
    pkill waybar || setsid -f waybar >/dev/null 2>&1
    ;;

  gaps)
    if [[ -f $STATE_DIR/gaps-off ]]; then
      rm -f "$STATE_DIR/gaps-off"
      hyprctl eval 'hl.config({ general = { gaps_in = 5, gaps_out = 10 } })' >/dev/null
    else
      mark gaps-off
      hyprctl eval 'hl.config({ general = { gaps_in = 0, gaps_out = 0 } })' >/dev/null
    fi
    ;;

  # Omarchy's workspace-layout toggle: dwindle for tiling, scrolling for a tape
  # of windows the workspace pans across. Per workspace, as Omarchy does it, so
  # one workspace can scroll while the rest tile.
  layout)
    workspace=$(hyprctl activeworkspace -j | jq -r '.id')
    case "$(hyprctl activeworkspace -j | jq -r '.tiledLayout')" in
      dwindle) layout=scrolling ;;
      *) layout=dwindle ;;
    esac
    hyprctl eval "hl.workspace_rule({ workspace = \"$workspace\", layout = \"$layout\" })" >/dev/null
    notify-send -a march -u low "󱂬    Workspace layout set to $layout" 2>/dev/null || true
    ;;

  # Coerce a lone window into a square, so a single terminal on a wide display
  # does not stretch the whole way across it. Omarchy keeps this in a config
  # fragment it copies in and out of a sourced directory; march has no such
  # directory, so the same two values are set directly.
  square)
    if [[ -f $STATE_DIR/square-on ]]; then
      rm -f "$STATE_DIR/square-on"
      # 0 0 is Hyprland's "no aspect ratio asked for".
      hyprctl eval 'hl.config({ layout = { single_window_aspect_ratio = { 0, 0 } } })' >/dev/null
    else
      mark square-on
      hyprctl eval 'hl.config({ layout = { single_window_aspect_ratio = { 1, 1 } } })' >/dev/null
    fi
    ;;

  *)
    echo "usage: march-toggle dnd|bar|gaps|layout|square" >&2
    exit 2
    ;;
esac
